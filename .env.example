# Copy to .env.local (local dev) and add the same values in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or "Connect").
# The publishable (anon) key is safe in the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Never add the Supabase service-role / secret key to this app.

# --- AI assistant (Phase 6). Leave AI_PROVIDER empty and the assistant stays off. ---
# Server-only. Never prefix these with NEXT_PUBLIC_.
# Get a key at console.anthropic.com (API billing is separate from a Claude Pro plan),
# and set a monthly spend limit there first.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Optional. Defaults: claude-opus-5-5, a $6/month app-side cap (~£5), 60 requests a day.
AI_MODEL=
AI_MONTHLY_BUDGET_USD=6
AI_DAILY_REQUEST_LIMIT=60

# --- Reminders (Phase 7). Generate with: npm run gen:secrets (prints to your terminal only) ---
# Server-only except the VAPID public key, which browsers need to subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-app.vercel.app
# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>" (32+ chars).
CRON_SECRET=
# Supabase → Project Settings → API Keys → Secret key. Bypasses RLS: used ONLY by the reminder job.
SUPABASE_SECRET_KEY=
